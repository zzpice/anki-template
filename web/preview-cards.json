 font-weight:500; }\n.mm-cloze.mm-active { font-weight:600; border-bottom:2px solid var(--accent); }\n.mm-cloze.mm-located { background:var(--soft); outline:2px solid var(--accent); outline-offset:3px; }\n.mm-sheet .mm-reveal { display:inline-block; min-width:44px; padding:4px 8px; margin:2px 0; color:var(--accent); font-weight:inherit; line-height:1.5; vertical-align:baseline; }\n.mm-sheet .mm-rehide { display:inline-block; min-width:44px; margin-left:4px; padding:2px 6px; color:var(--muted); font-size:.7em; vertical-align:baseline; }\n.mm-answer img { cursor:default; }\n.mm-search-mark { background:var(--mark); color:inherit; }\n.mm-search-current { outline:2px solid var(--accent); outline-offset:1px; }\n.mm-row.mm-search-row { background:var(--soft); }\n.mm-tree table { display:block; overflow-x:auto; max-width:100%; }\n.mm-tree img { max-width:100%; }\n.mm-tree .mm-cloze [hidden] { display:none !important; }\n.mm-sheet [hidden] { display:none !important; }\n@media (max-width:480px) {\n  .mm-tree .mm-list { padding-left:8px; margin-left:12px; }\n  .mm-tree .mm-root-list { padding:0; margin:0; }\n  .mm-tree .mm-list[data-mm-deep] { padding-left:0; margin-left:0; }\n  .mm-tools { font-size:.76em; }\n}\n",
